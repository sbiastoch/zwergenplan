{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!schema",
      "!**/*.schema.json",
      "!pnpm-lock.yaml",
      "!tests/fixtures/pipeline/html",
      "!tests/fixtures/pipeline/api",
      "!docs/design"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useImportExtensions": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**", ".claude/hooks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/pipeline/lib/**", "!scripts/pipeline/lib/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "fetch": "Netzzugriff gehört nach scripts/pipeline/io (Plan 0002)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**", "src/main.tsx", "!src/ui/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "navigator": "Geräte-APIs wie Geolocation nur über src/data (docs/architecture.md, Plan 0004).",
                  "localStorage": "Speicher nur über src/data/preferences.ts (docs/architecture.md).",
                  "fetch": "Netzzugriff nur über src/data (docs/architecture.md).",
                  "__zpSite": "Frühstart nur über src/data/site.ts (Plan 0008, E4)."
                }
              }
            }
          }
        }
      }
    }
  ]
}
