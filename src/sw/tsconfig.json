{
  // Eigener Typkontext des Service Workers (Plan 0011, E3): lib „webworker“ verträgt sich nicht mit „dom“.
  // Das Haupt-tsconfig.json schließt src/sw deshalb aus; check:fast prüft es als „Typen SW“, ohne Node-Typen.
  // Die Unit-Tests (Fixtures lesen mit node:fs) prüft tsconfig.test.json als „Typen SW-Tests“ (Arch-Review 0017, N8).
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023", "webworker"],
    "types": []
  },
  "include": ["."],
  "exclude": ["**/*.test.ts"]
}
