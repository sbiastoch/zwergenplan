{
  "name": "zwergenplan",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "dev": "pnpm data:build && vite",
    "build": "pnpm data:build && vite build",
    "preview": "vite preview --strictPort",
    "data:build": "node scripts/build-data.ts",
    "data:validate": "node scripts/validate-data.ts",
    "schema:export": "node scripts/export-schema.ts",
    "schema:check": "node scripts/export-schema.ts --check",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "arch": "node scripts/check-architecture.ts",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm build:e2e && pnpm build && playwright test",
    "size": "size-limit",
    "check:fast": "node scripts/check-fast.ts",
    "check": "pnpm check:fast && pnpm knip && pnpm schema:check && pnpm test:coverage && pnpm e2e && pnpm size",
    "build:e2e": "ZWERGENPLAN_DATA=fixture pnpm build",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "lefthook",
      "esbuild"
    ]
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "^14.1.0",
    "@swc/core": "1.16.13",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "ical.js": "2.2.1",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "size-limit": "14.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
